# Copy this file to .env and replace ALL values before running.
# Never commit .env to version control.
#
# Generate a strong JWT secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-hex-secret

# PostgreSQL credentials
DB_USER=change-this-username
DB_PASS=change-this-password

# Auth service users (used by load_test.py --username / --password)
AUTH_USER_1=nurzhan
AUTH_PASS_1=change-this-password
AUTH_USER_2=admin
AUTH_PASS_2=change-this-password

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASS=change-this-password
